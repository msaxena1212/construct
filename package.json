    "@angular/router": "^21.1.0",
    "ngx-toastr": "^20.0.5",
    "postcss": "^8.5.9",
    "prettier": "^3.8.3",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.24",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0",
