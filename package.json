{
  "name": "zyno_construction_backend",
  "version": "1.0.0",
  "description": "Zyno Construction Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:rollback": "node scripts/migrate.js down",
    "test": "jest --runInBand --forceExit --testTimeout=180000"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/shibbu/zyno_construction_backend.git"
  },
  "keywords": [
    "Backend",
    "Zyno",
    "Construction"
  ],
  "author": "Gyan Prakash, Vikash, Mayank",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/shibbu/zyno_construction_backend/issues"
  },
  "homepage": "https://gitlab.com/shibbu/zyno_construction_backend#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.22.0",
    "nodemailer": "^8.0.5",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup/database-env.js"
    ]
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "sqlite3": "^5.1.7",
    "supertest": "^7.3.1"
  }
}
