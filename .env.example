# =============================================================
# Zyno Construction Management Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================

# ─── Server ───────────────────────────────────────────────────
SERVER_PORT=3000
NODE_ENV=development              # development | production

# ─── Database (SQLite only) ───────────────────────────────────
# SQLite is the only permitted database. Every file must be an absolute path inside
# E:\Port\Construction\_sqlite_work. The application refuses to start without these settings.
# DB_TARGET_CLASS: isolated_test (tests; file name ends in .disposable.sqlite) or local_demo (file name ends in .sqlite)
DB_TARGET_CLASS=<CHANGE_ME>
DB_DIALECT=sqlite
DB_STORAGE=<CHANGE_ME: absolute path inside E:\Port\Construction\_sqlite_work>

# ─── JWT Authentication ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<CHANGE_ME>
JWT_EXPIRES_IN=24h

# ─── CORS — Comma-separated list of allowed client origins ───
# In Docker the Nginx container proxies /api/* so only localhost is needed
ALLOWED_ORIGINS=http://localhost:4200,http://localhost,https://zynoconstruction.elitetraveltech.in

# ─── AI / LLM Engine (Ollama) ─────────────────────────────────
AI_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
# Use a smaller model for dev; switch to gemma3:27b or gemma4:31b for production
OLLAMA_MODEL=gemma3:4b

# ─── File Storage Driver ──────────────────────────────────────
# Options: local | s3 | r2
STORAGE_DRIVER=local

# AWS S3 / Cloudflare R2 (only needed when STORAGE_DRIVER=s3 or r2)
AWS_ACCESS_KEY_ID=<CHANGE_ME>
AWS_SECRET_ACCESS_KEY=<CHANGE_ME>
AWS_S3_BUCKET=zyno-construction-files
AWS_REGION=ap-south-1
# For Cloudflare R2, set STORAGE_DRIVER=r2 and provide:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=zyno-construction-r2

# ─── Email / SMTP (for notifications) ────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=<CHANGE_ME>
MAIL_PASS=<CHANGE_ME>
MAIL_FROM="Zyno Platform" <developer@example.com>